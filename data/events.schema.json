{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://product.ai/schemas/tech-week-events.json",
  "title": "Product.ai LA Tech Week Event Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id","name","organizer","shortDescription","description","date","startTime","endTime","location","venue","address","categories","eventType","audience","companies","goals","roomSize","access","status","rsvpType","rsvpUrl","featured","productAIEvent","source"],
    "properties": {
      "id": { "type": "string", "pattern": "^event-[0-9]{3}$" },
      "name": { "type": "string", "minLength": 3 },
      "organizer": { "type": "string", "minLength": 2 },
      "shortDescription": { "type": "string", "minLength": 10 },
      "description": { "type": "string", "minLength": 20 },
      "date": { "type": "string", "format": "date" },
      "startTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
      "endTime": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
      "location": { "enum": ["Santa Monica","Venice","West LA","Culver City","Hollywood","DTLA"] },
      "venue": { "type": "string" }, "address": { "type": "string" },
      "categories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
      "eventType": { "enum": ["Small gatherings","Networking","Panels","Workshops","Hackathons","Demos","Parties","Founder dinners"] },
      "audience": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
      "companies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "goals": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
      "roomSize": { "enum": ["Small","Medium","Large"] },
      "access": { "enum": ["Open","Approval","Invite only"] },
      "status": { "enum": ["Open","Waitlist","Closed"] },
      "rsvpType": { "type": "string" }, "rsvpUrl": { "type": "string", "format": "uri" },
      "featured": { "type": "boolean" }, "productAIEvent": { "type": "boolean" },
      "source": { "type": "object", "additionalProperties": false, "required": ["name","url","verifiedAt"], "properties": { "name": {"type":"string"}, "url": {"type":"string","format":"uri"}, "verifiedAt": {"type":"string","format":"date-time"} } }
    }
  }
}
